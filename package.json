{
  "name": "playwright-ts-quality-kit",
  "version": "1.0.0",
  "description": "Reference Playwright + TypeScript framework: page objects, UI + API tests, tagged smoke/regression runs and CI.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
